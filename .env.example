# Domínio público do SignEng
SIGNENG_SITE_URL=https://signeng.online

# Novo projeto Supabase
# Preencha com os valores do painel: Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=COLOQUE_A_CHAVE_PUBLICA_AQUI

# Os nomes abaixo também são aceitos pelo servidor, caso prefira usá-los.
# SUPABASE_URL=https://SEU-PROJETO.supabase.co
# SUPABASE_ANON_KEY=COLOQUE_A_CHAVE_PUBLICA_AQUI

# O login permanece desativado enquanto esta versão pública estiver em teste.
SIGNENG_LOGIN_REQUIRED=false
